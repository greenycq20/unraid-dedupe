<script>
    let pollInterval = null;
    let logInterval = null;
    let currentDuplicates = [];

    function toggleLogs() { $('#logBox').slideToggle(); }
    
    function formatBytes(bytes, decimals) {
        decimals = decimals !== undefined ? decimals : 2;
        if (!+bytes) return '0 Bytes';
        var k = 1024;
        var dm = decimals < 0 ? 0 : decimals;
        var sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
        var i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    function formatDate(timestamp) {
        if (!timestamp) return 'N/A';
        var d = new Date(timestamp * 1000);
        return d.getFullYear() + '-' +
               String(d.getMonth() + 1).padStart(2, '0') + '-' +
               String(d.getDate()).padStart(2, '0') + ' ' +
               String(d.getHours()).padStart(2, '0') + ':' +
               String(d.getMinutes()).padStart(2, '0');
    }

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function resetButtons() {
        $('#btnScan').show().prop('disabled', false).val('Start Scan');
        $('#btnPause, #btnResume, #btnCancel').hide();
    }

    function stopPolling() {
        if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
        if (logInterval) { clearInterval(logInterval); logInterval = null; }
    }

    function showError(msg) {
        $('#statusArea').html('<i class="fa fa-exclamation-triangle" style="color:#e74c3c;"></i> ' + escapeHtml(msg));
    }

    $('#smartSelectMode').on('change', function() {
        if ($(this).val() === 'pattern') {
            $('#smartSelectPattern').show();
        } else {
            $('#smartSelectPattern').hide();
        }
    });

    function startScan() {
        var target = $('#targetPath').val();
        if (target.indexOf('/mnt/') !== 0) { alert("Path must start with /mnt/"); return; }

        $('#btnScan').hide();
        $('#btnPause, #btnCancel').show();
        $('#resultsArea').hide();
        $('#statusArea').html('<i class="fa fa-spinner fa-spin"></i> Initializing...');
        $('#progressContainer').show();
        $('#progressBar').css('width', '0%');
        $('#progressText').text('0%');
        $('#logBox').val('Scan started...\n');

        stopPolling();
        logInterval = setInterval(fetchLogs, 1000);

        $.post('/plugins/dedupe/api.php', { 
            action: 'scan',
            target: target,
            hashMethod: $('#hashMethod').val(),
            deepVerify: $('#deepVerify').is(':checked') ? '1' : '0',
            minFileSize: $('#minFileSize').val(),
            includeExt: $('#includeExt').val(),
            excludeExt: $('#excludeExt').val(),
            excludePatterns: $('#excludePatterns').val()
        }, function() {
            pollInterval = setInterval(checkStatus, 1500);
        }).fail(function(xhr) {
            showError('Failed to start scan: ' + (xhr.statusText || 'Network error'));
            resetButtons();
            $('#progressContainer').hide();
        });
    }

    function pauseScan() {
        $.post('/plugins/dedupe/api.php', { action: 'pause' }).fail(function() {
            showError('Failed to pause scan.');
        });
    }

    function resumeScan() {
        $.post('/plugins/dedupe/api.php', { action: 'resume' }).fail(function() {
            showError('Failed to resume scan.');
        });
    }

    function cancelScan() {
        if (confirm("Cancel the current scan?")) {
            $.post('/plugins/dedupe/api.php', { action: 'cancel' }).fail(function() {
                showError('Failed to cancel scan.');
            });
        }
    }

    function fetchLogs() {
        $.post('/plugins/dedupe/api.php', { action: 'logs' }, function(res) {
            var lb = $('#logBox');
            if (res && lb.val() !== res) { lb.val(res).scrollTop(lb[0].scrollHeight); }
        });
    }

    function checkStatus() {
        $.post('/plugins/dedupe/api.php', { action: 'status' }, function(res) {
            try {
                var data = (typeof res === 'object') ? res : JSON.parse(res);
                if (data.status === 'complete') {
                    stopPolling();
                    fetchLogs();
                    resetButtons();
                    $('#progressContainer').hide();
                    currentDuplicates = data.duplicates || [];
                    renderResults(currentDuplicates);
                } else if (data.status === 'running') {
                    $('#statusArea').html('<i class="fa fa-spinner fa-spin"></i> ' + escapeHtml(data.message || 'Scanning...'));
                    if (data.progress !== undefined) {
                        $('#progressBar').css('width', data.progress + '%');
                        $('#progressText').text(data.progress + '%');
                    }
                } else if (data.status === 'paused') {
                    $('#btnPause').hide();
                    $('#btnResume').show();
                    $('#statusArea').html('<i class="fa fa-pause"></i> Paused.');
                } else if (data.status === 'cancelled') {
                    stopPolling();
                    resetButtons();
                    $('#progressContainer').hide();
                    $('#statusArea').text('Scan cancelled.');
                } else if (data.status === 'idle') {
                    stopPolling();
                }
            } catch(e) {}
        });
    }

    function renderResults(duplicates) {
        var totalGroups = duplicates.length;
        var totalDupeFiles = 0;
        var totalWastedBytes = 0;

        duplicates.forEach(function(group) {
            var files = group.files || [];
            var extras = Math.max(0, files.length - 1);
            totalDupeFiles += extras;
            totalWastedBytes += (group.size || 0) * extras;
        });

        if (totalGroups === 0) {
            $('#statusArea').html('<i class="fa fa-check-circle" style="color:#27ae60;"></i> Scan complete. No duplicates found!');
            $('#resultsArea').hide();
            return;
        }

        $('#statusArea').html('<i class="fa fa-check-circle" style="color:#27ae60;"></i> Scan complete. Found <b>' + totalGroups + '</b> duplicate groups (' + totalDupeFiles + ' extra files, <b>' + formatBytes(totalWastedBytes) + '</b> reclaimable).');

        var html = '';
        duplicates.forEach(function(group, index) {
            var rowColor = (index % 2 === 0) ? 'rgba(0,0,0,0.03)' : 'transparent';
            var files = group.files || [];

            files.forEach(function(item, fileIdx) {
                var path = (typeof item === 'object') ? item.path : item;
                var mtime = (typeof item === 'object') ? item.mtime : null;
                var isChecked = fileIdx === 0 ? '' : 'checked';
                var isOriginalStyle = fileIdx === 0 ? 'font-weight:bold; color:#27ae60;' : '';
                var originalBadge = fileIdx === 0 ? ' <span class="keep-badge" style="font-size:0.75em; background:#27ae60; color:#fff; padding:1px 6px; border-radius:3px;">KEEP</span>' : '';

                html += '<tr style="background:' + rowColor + ';" data-group="' + index + '" data-fileidx="' + fileIdx + '">' +
                    '<td style="text-align: center;"><input type="checkbox" class="dupe-checkbox" data-group="' + index + '" data-size="' + (group.size || 0) + '" data-mtime="' + (mtime || 0) + '" value="' + escapeHtml(path) + '" ' + isChecked + ' onchange="updateSelectionSummary()"></td>' +
                    '<td class="file-path-col" style="' + isOriginalStyle + '">' + escapeHtml(path) + originalBadge + '</td>' +
                    '<td style="font-size:0.9em; color:#666;">' + formatDate(mtime) + '</td>' +
                    '<td style="font-family:monospace; font-size:0.85em;">Group ' + (index + 1) + '</td>' +
                    '<td>' + formatBytes(group.size) + '</td>' +
                    '</tr>';
            });
        });
        $('#duplicateList').html(html);
        $('#resultsArea').show();
        updateSelectionSummary();
    }

    function applySmartSelect() {
        var mode = $('#smartSelectMode').val();
        var pattern = $('#smartSelectPattern').val().toLowerCase().trim();

        // Process by group
        var groups = {};
        $('.dupe-checkbox').each(function() {
            var g = $(this).data('group');
            if (!groups[g]) groups[g] = [];
            groups[g].push($(this));
        });

        $.each(groups, function(groupIdx, boxArray) {
            if (boxArray.length <= 1) return;

            var keeperIndex = 0;

            if (mode === 'oldest') {
                // Find file with smallest mtime
                var minTime = Infinity;
                boxArray.forEach(function(box, i) {
                    var t = parseInt(box.data('mtime')) || 0;
                    if (t > 0 && t < minTime) { minTime = t; keeperIndex = i; }
                });
            } else if (mode === 'newest') {
                // Find file with largest mtime
                var maxTime = -1;
                boxArray.forEach(function(box, i) {
                    var t = parseInt(box.data('mtime')) || 0;
                    if (t > maxTime) { maxTime = t; keeperIndex = i; }
                });
            } else if (mode === 'shortest') {
                // Shortest string length
                var minLen = Infinity;
                boxArray.forEach(function(box, i) {
                    var len = box.val().length;
                    if (len < minLen) { minLen = len; keeperIndex = i; }
                });
            } else if (mode === 'pattern' && pattern) {
                // First file matching pattern
                var matched = false;
                boxArray.forEach(function(box, i) {
                    if (!matched && box.val().toLowerCase().indexOf(pattern) !== -1) {
                        keeperIndex = i;
                        matched = true;
                    }
                });
            }

            boxArray.forEach(function(box, i) {
                var isKeeper = (i === keeperIndex);
                box.prop('checked', !isKeeper);
                var row = box.closest('tr');
                var col = row.find('.file-path-col');
                col.find('.keep-badge').remove();

                if (isKeeper) {
                    col.css({'font-weight': 'bold', 'color': '#27ae60'});
                    col.append(' <span class="keep-badge" style="font-size:0.75em; background:#27ae60; color:#fff; padding:1px 6px; border-radius:3px;">KEEP</span>');
                } else {
                    col.css({'font-weight': 'normal', 'color': 'inherit'});
                }
            });
        });

        updateSelectionSummary();
    }

    function updateSelectionSummary() {
        var count = 0;
        var bytes = 0;
        $('.dupe-checkbox:checked').each(function() {
            count++;
            bytes += parseInt($(this).data('size')) || 0;
        });
        if (count > 0) {
            $('#selectionSummary').html('<b>' + count + '</b> files selected (<b style="color:#27ae60;">' + formatBytes(bytes) + '</b> to reclaim)');
        } else {
            $('#selectionSummary').text('0 files selected');
        }
    }

    function selectAllDupes() {
        $('.dupe-checkbox').prop('checked', true);
        updateSelectionSummary();
    }

    function deselectAllDupes() {
        $('.dupe-checkbox').prop('checked', false);
        updateSelectionSummary();
    }

    function exportToCSV() {
        if (!currentDuplicates || !currentDuplicates.length) {
            alert('No scan results to export.');
            return;
        }

        var csv = 'Group,File Path,Size (Bytes),Formatted Size,Modified Date,Selected For Delete\r\n';
        currentDuplicates.forEach(function(group, index) {
            var files = group.files || [];
            files.forEach(function(item) {
                var path = (typeof item === 'object') ? item.path : item;
                var mtime = (typeof item === 'object') ? item.mtime : null;
                var isChecked = $('.dupe-checkbox[value="' + CSS.escape(path) + '"]').is(':checked') ? 'YES' : 'NO';
                
                var cleanPath = '"' + path.replace(/"/g, '""') + '"';
                csv += [
                    index + 1,
                    cleanPath,
                    group.size || 0,
                    formatBytes(group.size),
                    formatDate(mtime),
                    isChecked
                ].join(',') + '\r\n';
            });
        });

        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', 'unraid_dedupe_report_' + new Date().toISOString().slice(0,10) + '.csv');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function confirmDeleteModal() {
        var toDelete = [];
        var totalBytes = 0;
        $('.dupe-checkbox:checked').each(function() {
            toDelete.push($(this).val());
            totalBytes += parseInt($(this).data('size')) || 0;
        });

        if (!toDelete.length) {
            alert('No files selected for deletion.');
            return;
        }

        var previewList = toDelete.slice(0, 5).map(function(f) { return ' • ' + f; }).join('\n');
        if (toDelete.length > 5) previewList += '\n ... and ' + (toDelete.length - 5) + ' more files.';

        var promptText = 'PERMANENT DELETION WARNING:\n\n' +
                         'Total files to delete: ' + toDelete.length + '\n' +
                         'Space to be reclaimed: ' + formatBytes(totalBytes) + '\n\n' +
                         'Files to be deleted:\n' + previewList + '\n\n' +
                         'Are you absolutely sure you want to proceed? This cannot be undone.';

        if (!confirm(promptText)) return;

        $('#statusArea').html('<i class="fa fa-spinner fa-spin"></i> Deleting ' + toDelete.length + ' files...');
        
        $.post('/plugins/dedupe/api.php', { action: 'delete', files: toDelete }, function(res) {
            try {
                var data = (typeof res === 'object') ? res : JSON.parse(res);
                if (data.success) {
                    $('#statusArea').html('<i class="fa fa-check-circle" style="color:#27ae60;"></i> Deleted ' + data.deleted + ' files. Reclaimed ' + escapeHtml(data.space) + '.');
                    $('.dupe-checkbox:checked').closest('tr').fadeOut(300, function() {
                        $(this).remove();
                        updateSelectionSummary();
                    });
                } else {
                    showError('Delete failed: ' + (data.error || 'Unknown error'));
                }
            } catch(e) {
                showError('Invalid server response during deletion.');
            }
        }).fail(function(xhr) {
            showError('Delete request failed: ' + (xhr.statusText || 'Network error'));
        });
    }

    function clearResults() {
        if ($('#resultsArea').is(':visible') && !confirm('Clear all scan results?')) return;
        $.post('/plugins/dedupe/api.php', { action: 'clear' }, function() {
            currentDuplicates = [];
            $('#resultsArea').hide();
            $('#duplicateList').html('');
            $('#statusArea').text('Ready.');
            resetButtons();
        }).fail(function() {
            showError('Failed to clear results.');
        });
    }

    function saveSchedule() {
        var schedule = $('#scheduleSetting').val();
        var target = $('#targetPath').val();
        $('#scheduleStatus').text('Saving...');

        $.post('/plugins/dedupe/api.php', {
            action: 'save_schedule',
            schedule: schedule,
            target: target
        }, function(res) {
            try {
                var data = (typeof res === 'object') ? res : JSON.parse(res);
                if (data.success) {
                    $('#scheduleStatus').text('Saved! (' + schedule + ')');
                    setTimeout(function() { $('#scheduleStatus').fadeOut(1000, function() { $(this).text('').show(); }); }, 3000);
                } else {
                    $('#scheduleStatus').text('Error saving schedule');
                }
            } catch(e) {
                $('#scheduleStatus').text('Error');
            }
        }).fail(function() {
            $('#scheduleStatus').text('Failed');
        });
    }

    /* On page load: check if there's an existing scan running or completed results */
    $(function() {
        $.post('/plugins/dedupe/api.php', { action: 'status' }, function(res) {
            try {
                var data = (typeof res === 'object') ? res : JSON.parse(res);
                if (data.status === 'complete') {
                    currentDuplicates = data.duplicates || [];
                    renderResults(currentDuplicates);
                } else if (data.status === 'running' || data.status === 'paused') {
                    $('#btnScan').hide();
                    if (data.status === 'paused') {
                        $('#btnResume, #btnCancel').show();
                        $('#statusArea').html('<i class="fa fa-pause"></i> Paused.');
                    } else {
                        $('#btnPause, #btnCancel').show();
                    }
                    $('#progressContainer').show();
                    pollInterval = setInterval(checkStatus, 1500);
                    logInterval = setInterval(fetchLogs, 1000);
                    checkStatus();
                }
            } catch(e) {}
        });
    });
</script>
]]>
</INLINE>
</FILE>

<!-- 3. API BACKEND -->
<FILE Name="/usr/local/emhttp/plugins/&name;/api.php">
<INLINE>
<![CDATA[
<?php
header('Content-Type: application/json; charset=utf-8');

$action = $_POST['action'] ?? '';
$statusFile = '/tmp/dedupe_status.json';
$logFile = '/tmp/dedupe_scan.log';
$pidFile = '/tmp/dedupe_scan.pid';
$cfgDir = '/boot/config/plugins/dedupe';
$cfgFile = "$cfgDir/dedupe.cfg";
$cronFile = '/etc/cron.d/dedupe_scan';

function formatBytes($bytes) {
    if ($bytes <= 0) return '0 B';
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    $i = floor(log($bytes, 1024));
    return round($bytes / pow(1024, $i), 2) . ' ' . $units[$i];
}

function rotateLogIfNeeded($file, $maxBytes = 1048576, $keepLines = 1000) {
    if (file_exists($file) && filesize($file) > $maxBytes) {
        $lines = file($file);
        $sliced = array_slice($lines, -$keepLines);
        file_put_contents($file, "[Log rotated due to size limit]\n" . implode("", $sliced));
    }
}

function getValidPid($pidFile) {
    if (!file_exists($pidFile)) return false;
    $pid = trim(file_get_contents($pidFile));
    if (!preg_match('/^\d+$/', $pid)) return false;
    if (!file_exists("/proc/$pid")) return false;
    return $pid;
}

/* --- Action: Return scan logs --- */
if ($action === 'logs') {
    echo file_exists($logFile) ? file_get_contents($logFile) : "";
    exit;
}

/* --- Action: Start a new scan --- */
if ($action === 'scan') {
    $target = $_POST['target'] ?? '';
    $hashMethod = $_POST['hashMethod'] ?? 'sha256sum';
    $deepVerify = $_POST['deepVerify'] ?? '0';
    $minFileSize = $_POST['minFileSize'] ?? '0';
    $includeExt = $_POST['includeExt'] ?? '';
    $excludeExt = $_POST['excludeExt'] ?? '';
    $excludePatterns = $_POST['excludePatterns'] ?? '';

    $realTarget = realpath($target);
    if ($realTarget === false || strpos($realTarget, '/mnt/') !== 0) {
        echo json_encode(['success' => false, 'error' => 'Invalid target path. Must be under /mnt/.']);
        exit;
    }

    $allowedMethods = ['md5sum', 'sha1sum', 'sha224sum', 'sha256sum', 'sha384sum', 'sha512sum'];
    if (!in_array($hashMethod, $allowedMethods)) {
        echo json_encode(['success' => false, 'error' => 'Invalid hash method.']);
        exit;
    }

    $deepVerify = ($deepVerify === '1') ? '1' : '0';
    $minFileSize = preg_match('/^\d+$/', $minFileSize) ? $minFileSize : '0';

    if (file_exists($statusFile)) unlink($statusFile);
    if (file_exists($logFile)) unlink($logFile);
    
    $script = '/usr/local/emhttp/plugins/dedupe/scripts/scan.sh';
    $cmd = sprintf(
        "nohup bash %s %s %s %s %s %s %s %s > /dev/null 2>&1 & echo $!",
        escapeshellarg($script),
        escapeshellarg($realTarget),
        escapeshellarg($hashMethod),
        escapeshellarg($deepVerify),
        escapeshellarg($minFileSize),
        escapeshellarg($excludePatterns),
        escapeshellarg($includeExt),
        escapeshellarg($excludeExt)
    );
    exec($cmd, $output);
    if (!empty($output[0])) {
        file_put_contents($pidFile, trim($output[0]));
    }
    echo json_encode(['success' => true]);
    exit;
}

/* --- Action: Delete selected files --- */
if ($action === 'delete') {
    $files = $_POST['files'] ?? [];
    if (!is_array($files)) {
        echo json_encode(['success' => false, 'error' => 'Invalid file list.']);
        exit;
    }
    $count = 0;
    $bytesReclaimed = 0;
    $errors = [];
    foreach ($files as $file) {
        $realFile = realpath($file);
        if ($realFile === false) {
            $errors[] = "Not found: $file";
            continue;
        }
        if (strpos($realFile, '/mnt/') !== 0) {
            $errors[] = "Outside /mnt/: $file";
            continue;
        }
        if (!is_file($realFile)) {
            $errors[] = "Not a file: $file";
            continue;
        }
        $size = filesize($realFile);
        if (unlink($realFile)) {
            $bytesReclaimed += $size;
            $count++;
        } else {
            $errors[] = "Delete failed: $file";
        }
    }
    $spaceStr = formatBytes($bytesReclaimed);
    $msg = "\n[" . date('H:i:s') . "] Deleted $count files. Reclaimed $spaceStr of space.";
    if (!empty($errors)) {
        $msg .= "\n[" . date('H:i:s') . "] Errors: " . implode('; ', array_slice($errors, 0, 10));
    }
    file_put_contents($logFile, $msg, FILE_APPEND);
    rotateLogIfNeeded($logFile);

    echo json_encode(['success' => true, 'deleted' => $count, 'space' => $spaceStr, 'errors' => $errors]);
    exit;
}

/* --- Action: Return current status --- */
if ($action === 'status') {
    echo file_exists($statusFile) ? file_get_contents($statusFile) : json_encode(['status' => 'idle']);
    exit;
}

/* --- Action: Clear results and logs --- */
if ($action === 'clear') {
    @unlink($statusFile);
    @unlink($logFile);
    echo json_encode(['success' => true]);
    exit;
}

/* --- Action: Pause scan --- */
if ($action === 'pause') {
    $pid = getValidPid($pidFile);
    if ($pid !== false) {
        exec("pkill -STOP -P " . escapeshellarg($pid) . "; kill -STOP " . escapeshellarg($pid));
        $tmpStatus = $statusFile . '.tmp';
        file_put_contents($tmpStatus, json_encode(['status' => 'paused']));
        rename($tmpStatus, $statusFile);
        echo json_encode(['success' => true]);
    } else {
        echo json_encode(['success' => false, 'error' => 'No running scan found.']);
    }
    exit;
}

/* --- Action: Resume scan --- */
if ($action === 'resume') {
    $pid = getValidPid($pidFile);
    if ($pid !== false) {
        exec("pkill -CONT -P " . escapeshellarg($pid) . "; kill -CONT " . escapeshellarg($pid));
        $tmpStatus = $statusFile . '.tmp';
        file_put_contents($tmpStatus, json_encode(['status' => 'running', 'message' => 'Resuming...', 'progress' => 0]));
        rename($tmpStatus, $statusFile);
        echo json_encode(['success' => true]);
    } else {
        echo json_encode(['success' => false, 'error' => 'No paused scan found.']);
    }
    exit;
}

/* --- Action: Cancel scan --- */
if ($action === 'cancel') {
    $pid = getValidPid($pidFile);
    if ($pid !== false) {
        exec("pkill -TERM -P " . escapeshellarg($pid) . "; kill -TERM " . escapeshellarg($pid));
    }
    $tmpStatus = $statusFile . '.tmp';
    file_put_contents($tmpStatus, json_encode(['status' => 'cancelled']));
    rename($tmpStatus, $statusFile);
    @unlink($pidFile);
    echo json_encode(['success' => true]);
    exit;
}

/* --- Action: Save Schedule Configuration --- */
if ($action === 'save_schedule') {
    $schedule = $_POST['schedule'] ?? 'disabled';
    $target = $_POST['target'] ?? '/mnt/user/';

    if (!is_dir($cfgDir)) {
        @mkdir($cfgDir, 0755, true);
    }

    $cfgContent = "schedule=\"$schedule\"\nschedule_target=\"$target\"\n";
    file_put_contents($cfgFile, $cfgContent);

    // Update cron entry
    if ($schedule === 'disabled') {
        @unlink($cronFile);
    } else {
        $cronTiming = '0 3 * * *'; // daily at 03:00
        if ($schedule === 'weekly') { $cronTiming = '0 3 * * 0'; }
        if ($schedule === 'monthly') { $cronTiming = '0 3 1 * *'; }

        $cronCmd = "$cronTiming root /usr/local/emhttp/plugins/dedupe/scripts/scan.sh " .
                   escapeshellarg($target) . " sha256sum 0 1048576 .Recycle.Bin,@eaDir,.Trash >/dev/null 2>&1\n";
        file_put_contents($cronFile, $cronCmd);
    }

    echo json_encode(['success' => true, 'schedule' => $schedule]);
    exit;
}

echo json_encode(['success' => false, 'error' => 'Unknown action.']);
?>
]]>
</INLINE>
</FILE>

<!-- 4. SCAN SCRIPT — Background deduplication engine -->
<FILE Name="/usr/local/emhttp/plugins/&name;/scripts/scan.sh" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
# Dedupe Scanner — Background scan script
# Usage: scan.sh <target> <hash_cmd> <deep_verify> <min_size> <exclude_patterns> [include_ext] [exclude_ext]

set -euo pipefail

TARGET="$1"
HASH_CMD="$2"
DEEP_VERIFY="${3:-0}"
MIN_SIZE="${4:-0}"
EXCLUDE_PATTERNS="${5:-}"
INCLUDE_EXT="${6:-}"
EXCLUDE_EXT="${7:-}"

STATUS_FILE="/tmp/dedupe_status.json"
LOG_FILE="/tmp/dedupe_scan.log"
TMP_HASHES=$(mktemp /tmp/dedupe_hashes.XXXXXX)
TMP_CANDIDATES=$(mktemp /tmp/dedupe_candidates.XXXXXX)

cleanup() {
    rm -f "$TMP_HASHES" "$TMP_CANDIDATES"
}
trap cleanup EXIT

update_status() {
    local tmp="${STATUS_FILE}.tmp"
    echo "{\"status\":\"running\",\"progress\":$1,\"message\":\"$2\"}" > "$tmp"
    mv -f "$tmp" "$STATUS_FILE"
}

rotate_log() {
    if [ -f "$LOG_FILE" ] && [ $(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0) -gt 1048576 ]; then
        tail -n 1000 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv -f "${LOG_FILE}.tmp" "$LOG_FILE"
    fi
}

log_msg() {
    rotate_log
    echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

log_msg "=== Dedupe Scan Started ==="
log_msg "Target: $TARGET"
log_msg "Hash Method: $HASH_CMD"
log_msg "Deep Verify: $([ "$DEEP_VERIFY" = "1" ] && echo "Enabled" || echo "Disabled")"
log_msg "Min File Size: $MIN_SIZE bytes"
log_msg "Include Extensions: ${INCLUDE_EXT:-all}"
log_msg "Exclude Extensions: ${EXCLUDE_EXT:-none}"
log_msg "Exclude Patterns: ${EXCLUDE_PATTERNS:-none}"

# --- Step 1: Find all files matching criteria ---
update_status 5 "Step 1/4: Indexing files..."

FIND_CMD="find \"$TARGET\" -type f"

# Minimum size filter
if [ "$MIN_SIZE" -gt 0 ] 2>/dev/null; then
    FIND_CMD="$FIND_CMD -size +${MIN_SIZE}c"
fi

# Exclude folder patterns
if [ -n "$EXCLUDE_PATTERNS" ]; then
    IFS=',' read -ra PATTERNS <<< "$EXCLUDE_PATTERNS"
    for pattern in "${PATTERNS[@]}"; do
        pattern=$(echo "$pattern" | xargs)
        if [ -n "$pattern" ]; then
            FIND_CMD="$FIND_CMD -not -path \"*/${pattern}/*\""
        fi
    done
fi

# Exclude file extensions
if [ -n "$EXCLUDE_EXT" ]; then
    IFS=',' read -ra EXTS <<< "$EXCLUDE_EXT"
    for ext in "${EXTS[@]}"; do
        ext=$(echo "$ext" | xargs | sed 's/^\.//')
        if [ -n "$ext" ]; then
            FIND_CMD="$FIND_CMD -not -iname \"*.${ext}\""
        fi
    done
fi

# Include file extensions
if [ -n "$INCLUDE_EXT" ]; then
    IFS=',' read -ra INCS <<< "$INCLUDE_EXT"
    INC_CLAUSE=""
    for ext in "${INCS[@]}"; do
        ext=$(echo "$ext" | xargs | sed 's/^\.//')
        if [ -n "$ext" ]; then
            if [ -z "$INC_CLAUSE" ]; then
                INC_CLAUSE="-iname \"*.${ext}\""
            else
                INC_CLAUSE="$INC_CLAUSE -o -iname \"*.${ext}\""
            fi
        fi
    done
    if [ -n "$INC_CLAUSE" ]; then
        FIND_CMD="$FIND_CMD \\( $INC_CLAUSE \\)"
    fi
fi

# Output format: %s (size in bytes), %T@ (epoch modification time), %p (path)
FIND_CMD="$FIND_CMD -printf \"%s\t%T@\t%p\n\""

eval "$FIND_CMD" 2>/dev/null | sort -n > "$TMP_CANDIDATES"
TOTAL_FILES=$(wc -l < "$TMP_CANDIDATES")
log_msg "Found $TOTAL_FILES candidate files matching criteria."

if [ "$TOTAL_FILES" -eq 0 ]; then
    log_msg "No files found matching criteria. Scan complete."
    tmp="${STATUS_FILE}.tmp"
    echo '{"status":"complete","duplicates":[]}' > "$tmp"
    mv -f "$tmp" "$STATUS_FILE"
    exit 0
fi

# --- Step 2: Identify size duplicates ---
update_status 15 "Step 2/4: Identifying size duplicates..."

POTENTIAL=$(awk -F'\t' '{count[$1]++} END{c=0; for(i in count) if(count[i]>1) c+=count[i]; print c}' "$TMP_CANDIDATES")
log_msg "Found $POTENTIAL files with matching sizes."

if [ -z "$POTENTIAL" ] || [ "$POTENTIAL" -eq 0 ] 2>/dev/null; then
    log_msg "No files share identical sizes. No duplicates possible. Scan complete."
    tmp="${STATUS_FILE}.tmp"
    echo '{"status":"complete","duplicates":[]}' > "$tmp"
    mv -f "$tmp" "$STATUS_FILE"
    exit 0
fi

# --- Step 3: Hash only matching-size candidates ---
update_status 30 "Step 3/4: Hashing $POTENTIAL candidates..."

# Group paths by size, extract only those with count > 1
awk -F'\t' '{
    path = $3
    mtime = int($2)
    entry = path "\t" mtime
    a[$1] = a[$1] ? a[$1] "\n" entry : entry
    count[$1]++
} END {
    for(i in count) if(count[i] > 1) print a[i]
}' "$TMP_CANDIDATES" > "${TMP_CANDIDATES}.filtered"

# Run hashing command and save hash + mtime + path
awk -F'\t' '{print $1}' "${TMP_CANDIDATES}.filtered" \
    | tr '\n' '\0' \
    | xargs -0 -n 10 "$HASH_CMD" 2>/dev/null \
    | awk -v total="$POTENTIAL" -v sf="$STATUS_FILE" '
{
    print $0; count++
    if (count % 50 == 0 || count == total) {
        p = 30 + int((count * 50) / (total > 0 ? total : 1))
        if (p > 80) p = 80
        tmp = sf ".tmp"
        printf "{\"status\":\"running\",\"progress\":%d,\"message\":\"Hashing %d/%d files...\"}", p, count, total > tmp
        close(tmp)
        system("mv -f " tmp " " sf)
    }
}' > "$TMP_HASHES"

# --- Step 4: Finalize duplicates and metadata ---
update_status 85 "Step 4/4: Finalizing report..."

/usr/bin/php -r '
    $hashFile = $argv[1];
    $statusFile = $argv[2];
    $logFile = $argv[3];
    $deepVerify = $argv[4];

    $lines = file($hashFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    $hashes = [];
    foreach ($lines as $l) {
        if (preg_match("/^([a-f0-9]+)\s+(.+)$/", $l, $m)) {
            $hashes[$m[1]][] = $m[2];
        }
    }

    $dupes = [];
    $totalWasted = 0;

    foreach ($hashes as $h => $files) {
        if (count($files) <= 1) continue;

        if ($deepVerify === "1") {
            $verified = [];
            $used = array_fill(0, count($files), false);

            for ($i = 0; $i < count($files); $i++) {
                if ($used[$i]) continue;
                $group = [$files[$i]];
                $used[$i] = true;

                for ($j = $i + 1; $j < count($files); $j++) {
                    if ($used[$j]) continue;
                    $ret = 0;
                    exec("cmp -s " . escapeshellarg($files[$i]) . " " . escapeshellarg($files[$j]), $out, $ret);
                    if ($ret === 0) {
                        $group[] = $files[$j];
                        $used[$j] = true;
                    }
                }

                if (count($group) > 1) {
                    $size = @filesize($group[0]) ?: 0;
                    $fileObjects = [];
                    foreach ($group as $f) {
                        $fileObjects[] = ["path" => $f, "mtime" => @filemtime($f) ?: 0];
                    }
                    $dupes[] = ["hash" => $h, "files" => $fileObjects, "size" => $size];
                    $totalWasted += $size * (count($group) - 1);
                }
            }
        } else {
            $size = @filesize($files[0]) ?: 0;
            $fileObjects = [];
            foreach ($files as $f) {
                $fileObjects[] = ["path" => $f, "mtime" => @filemtime($f) ?: 0];
            }
            $dupes[] = ["hash" => $h, "files" => $fileObjects, "size" => $size];
            $totalWasted += $size * (count($files) - 1);
        }
    }

    $tmp = $statusFile . ".tmp";
    file_put_contents($tmp, json_encode(["status" => "complete", "duplicates" => $dupes]));
    rename($tmp, $statusFile);

    $groupCount = count($dupes);
    $fileCount = 0;
    foreach ($dupes as $d) { $fileCount += count($d["files"]); }

    $units = ["B", "KB", "MB", "GB", "TB"];
    $ui = 0;
    $w = (float)$totalWasted;
    while ($w >= 1024 && $ui < 4) { $w /= 1024; $ui++; }
    $wastedStr = round($w, 2) . " " . $units[$ui];

    $msg = "[" . date("H:i:s") . "] === Scan Complete ===\n";
    $msg .= "[" . date("H:i:s") . "] Found $groupCount duplicate groups ($fileCount total files).\n";
    $msg .= "[" . date("H:i:s") . "] Potential space savings: $wastedStr\n";
    if ($deepVerify === "1") {
        $msg .= "[" . date("H:i:s") . "] Deep verification: Byte-verified matching.\n";
    }
    file_put_contents($logFile, $msg, FILE_APPEND);

    // Unraid Native Notification
    $notifyMsg = "Found $groupCount duplicate groups. Potential savings: $wastedStr";
    exec("/usr/local/emhttp/webGui/scripts/notify " .
         "-e \"Dedupe\" " .
         "-s \"Dedupe Scan Finished\" " .
         "-d " . escapeshellarg($notifyMsg) . " " .
         "-i normal");
' "$TMP_HASHES" "$STATUS_FILE" "$LOG_FILE" "$DEEP_VERIFY"

log_msg "Scanner finished successfully."
]]>
</INLINE>
</FILE>

<!-- 5. UNINSTALLATION HOOK -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
echo "Removing dedupe plugin and cleaning up..."
# Remove scheduled cron if present
rm -f /etc/cron.d/dedupe_scan

# Stop any running scan
if [ -f /tmp/dedupe_scan.pid ]; then
    PID=$(cat /tmp/dedupe_scan.pid)
    if echo "$PID" | grep -qE '^[0-9]+$'; then
        pkill -TERM -P "$PID" 2>/dev/null || true
        kill -TERM "$PID" 2>/dev/null || true
    fi
fi

# Remove webGUI files
rm -rf /usr/local/emhttp/plugins/dedupe

# Clean up temp data
rm -f /tmp/dedupe_status.json /tmp/dedupe_status.json.tmp
rm -f /tmp/dedupe_scan.log /tmp/dedupe_scan.pid
rm -f /tmp/dedupe_hashes.* /tmp/dedupe_candidates.*
echo "Cleanup complete. Dedupe has been removed from your Utilities menu."
]]>
</INLINE>
</FILE>

</PLUGIN>
