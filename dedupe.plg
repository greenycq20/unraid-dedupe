- Restored clean baseline execution engine to ensure progress bar and live logging run smoothly.
</CHANGES>

<DESCRIPTION>
A high-performance deduplication tool for Unraid. Scan your shares for identical files using hardware-accelerated SHA/MD5 hashing and reclaim wasted array space with ease.
</DESCRIPTION>

<!-- 1. PAGE FILE -->
<FILE Name="/usr/local/emhttp/plugins/&name;/Dedupe.page">
<INLINE>
<![CDATA[
Menu="Utilities"
Title="Dedupe Tool"
Icon="clone"
---
<?php include '/usr/local/emhttp/plugins/dedupe/Dedupe.php'; ?>
]]>
</INLINE>
</FILE>

<!-- 2. MAIN UI -->
<FILE Name="/usr/local/emhttp/plugins/&name;/Dedupe.php">
<INLINE>
<![CDATA[
<?php
$shares = [];
$userSharesPath = '/mnt/user';
if (is_dir($userSharesPath)) {
    $dirs = array_filter(glob($userSharesPath . '/*'), 'is_dir');
    foreach ($dirs as $dir) { $shares[] = basename($dir); }
}
?>

<div style="width: 100%; max-width: 1200px; margin: 0 auto;">
    <h2>Deduplication Scanner</h2>
    <p>Select a specific share or directory to scan for identical files.</p>
    
    <table class="settings">
        <tr>
            <td style="width: 20%;"><b>Target Path:</b></td>
            <td>
                <select id="targetPath">
                    <option value="/mnt/user/">All User Shares (/mnt/user/)</option>
                    <?php foreach($shares as $share): ?>
                        <option value="/mnt/user/<?= htmlspecialchars($share, ENT_QUOTES, 'UTF-8') ?>"><?= htmlspecialchars($share, ENT_QUOTES, 'UTF-8') ?></option>
                    <?php endforeach; ?>
                </select>
            </td>
        </tr>
        <tr>
            <td>
                <a href="javascript:void(0)" onclick="$('#advanced_settings').slideToggle()" style="text-decoration:none; color:inherit;">
                    <i class="fa fa-cog"></i> <b>Advanced Settings</b> <i class="fa fa-chevron-down"></i>
                </a>
            </td>
            <td>
                <div id="advanced_settings" style="display:none; padding: 15px; background: rgba(0,0,0,0.1); border-radius: 4px;">
                    <div style="margin-bottom:15px;">
                        <label><b>Hash Method:</b></label><br>
                        <select id="hashMethod" style="margin-top:5px; width: 300px;">
                            <option value="md5sum">MD5 (Fastest, widely compatible)</option>
                            <option value="sha1sum">SHA-1</option>
                            <option value="sha224sum">SHA-224</option>
                            <option value="sha256sum" selected>SHA-256 (Modern standard)</option>
                            <option value="sha384sum">SHA-384</option>
                            <option value="sha512sum">SHA-512 (High performance on 64-bit)</option>
                        </select>
                        <div style="font-size:0.9em; color:#888; margin-top:4px;">Note: Performance may vary based on CPU hardware acceleration support.</div>
                    </div>
                    <div>
                        <input type="checkbox" id="deepVerify" value="1">
                        <label for="deepVerify"><b>Deep Verification:</b> (Perform byte-by-byte comparison to ensure 100% data integrity)</label>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td><b>Actions:</b></td>
            <td>
                <input type="button" id="btnScan" value="Start Scan" onclick="startScan()">
                <input type="button" id="btnPause" value="Pause" onclick="pauseScan()" style="display: none; background: #f39c12; color: white;">
                <input type="button" id="btnResume" value="Resume" onclick="resumeScan()" style="display: none; background: #27ae60; color: white;">
                <input type="button" id="btnCancel" value="Cancel" onclick="cancelScan()" style="display: none; background: #e74c3c; color: white;">
                <input type="button" id="btnLogs" value="Toggle Logs" onclick="toggleLogs()">
            </td>
        </tr>
    </table>

    <div id="statusArea" style="margin-top: 20px; font-weight: bold;">Ready.</div>
    
    <div id="progressContainer" style="display: none; width: 100%; background: #2c2d30; border-radius: 4px; margin-top: 10px; border: 1px solid #444; position: relative; height: 26px; overflow: hidden;">
        <div id="progressBar" style="width: 0%; height: 100%; background: #ff8c00; transition: width 0.3s ease;"></div>
        <div id="progressText" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; text-align: center; line-height: 26px; color: #fff; font-weight: bold; font-size: 13px; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">0%</div>
    </div>

    <textarea id="logBox" style="width: 100%; height: 300px; display: none; font-family: monospace; margin-top: 15px; padding: 10px; box-sizing: border-box;" readonly></textarea>
    
    <div id="resultsArea" style="display: none; margin-top: 30px;">
        <div style="display: flex; gap: 10px; margin-bottom: 15px;">
            <input type="button" value="Delete Selected Duplicates" onclick="deleteSelected()" style="color: #d9534f; font-weight: bold;">
            <input type="button" value="Clear Results" onclick="clearResults()" style="font-weight: bold;">
        </div>
        
        <table class="tablesorter">
            <thead>
                <tr>
                    <th style="width: 5%;">Select</th>
                    <th style="width: 55%;">File Path</th>
                    <th style="width: 25%;">Group Hash</th>
                    <th style="width: 15%;">Size</th>
                </tr>
            </thead>
            <tbody id="duplicateList"></tbody>
        </table>
    </div>
</div>

<script>
    let pollInterval, logInterval;

    function toggleLogs() { $('#logBox').slideToggle(); }
    
    function formatBytes(bytes, decimals = 2) {
        if (!+bytes) return '0 Bytes';
        const k = 1024, dm = decimals < 0 ? 0 : decimals, sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
    }

    function escapeHtml(str) {
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function resetButtons() {
        $('#btnScan').show().prop('disabled', false).val('Start Scan');
        $('#btnPause, #btnResume, #btnCancel').hide();
    }

    function startScan() {
        const target = $('#targetPath').val();
        if(!target.startsWith('/mnt/')) return alert("Path must start with /mnt/");

        $('#btnScan').hide();
        $('#btnPause, #btnCancel').show();
        $('#resultsArea').hide();
        $('#statusArea').html('<i class="fa fa-spinner fa-spin"></i> Initializing...');
        $('#progressContainer').show();
        $('#progressBar').css('width', '0%');
        $('#progressText').text('0%');
        $('#logBox').val('Scan started...\n');

        if(logInterval) clearInterval(logInterval);
        logInterval = setInterval(fetchLogs, 1000);

        $.post('/plugins/dedupe/api.php', { 
            action: 'scan', target: target, hashMethod: $('#hashMethod').val(), deepVerify: $('#deepVerify').is(':checked') ? '1' : '0' 
        }, function(res) {
            if(pollInterval) clearInterval(pollInterval);
            pollInterval = setInterval(checkStatus, 1000);
        }).fail(function(xhr) {
            alert('Scan request failed: ' + xhr.statusText);
            resetButtons();
            $('#progressContainer').hide();
        });
    }

    function pauseScan() { $.post('/plugins/dedupe/api.php', { action: 'pause' }); }
    function resumeScan() { $.post('/plugins/dedupe/api.php', { action: 'resume' }); }
    function cancelScan() { if(confirm("Cancel scan?")) $.post('/plugins/dedupe/api.php', { action: 'cancel' }); }

    function fetchLogs() {
        $.post('/plugins/dedupe/api.php', { action: 'logs' }, function(res) {
            const lb = $('#logBox');
            if(res && lb.val() !== res) { lb.val(res).scrollTop(lb[0].scrollHeight); }
        });
    }

    function checkStatus() {
        $.post('/plugins/dedupe/api.php', { action: 'status' }, function(res) {
            try {
                const data = (typeof res === 'object') ? res : JSON.parse(res);
                if (data.status === 'complete') {
                    clearInterval(pollInterval); clearInterval(logInterval);
                    fetchLogs(); resetButtons(); $('#progressContainer').hide();
                    renderResults(data.duplicates || []);
                } else if (data.status === 'running') {
                    $('#statusArea').html(`<i class="fa fa-spinner fa-spin"></i> ${escapeHtml(data.message)}`);
                    if (data.progress !== undefined) { $('#progressBar').css('width', data.progress + '%'); $('#progressText').text(data.progress + '%'); }
                } else if (data.status === 'paused') {
                    $('#btnPause').hide(); $('#btnResume').show(); $('#statusArea').html(`<i class="fa fa-pause"></i> Paused.`);
                } else if (data.status === 'cancelled') {
                    clearInterval(pollInterval); clearInterval(logInterval);
                    resetButtons(); $('#progressContainer').hide(); $('#statusArea').text('Cancelled.');
                }
            } catch(e) {}
        });
    }

    function renderResults(duplicates) {
        $('#statusArea').html(`Scan complete. Found ${duplicates.length} duplicate groups.`);
        if (duplicates.length === 0) return;
        let html = '';
        duplicates.forEach((group, index) => {
            group.files.forEach((file, fileIdx) => {
                const isChecked = fileIdx === 0 ? '' : 'checked';
                html += `<tr>
                    <td style="text-align: center;"><input type="checkbox" class="dupe-checkbox" value="${escapeHtml(file)}" ${isChecked}></td>
                    <td>${escapeHtml(file)}</td>
                    <td>Group ${index + 1}</td>
                    <td>${formatBytes(group.size)}</td>
                </tr>`;
            });
        });
        $('#duplicateList').html(html); $('#resultsArea').show();
    }

    function deleteSelected() {
        const toDelete = [];
        $('.dupe-checkbox:checked').each(function() { toDelete.push($(this).val()); });
        if (!toDelete.length || !confirm(`Delete ${toDelete.length} files?`)) return;
        
        $.post('/plugins/dedupe/api.php', { action: 'delete', files: toDelete }, function(res) {
            const data = (typeof res === 'object') ? res : JSON.parse(res);
            alert(`Deleted ${data.deleted} files. Reclaimed ${data.space}.`);
            clearResults();
        });
    }

    function clearResults() {
        $.post('/plugins/dedupe/api.php', { action: 'clear' }, function() {
            $('#resultsArea').hide(); $('#statusArea').text('Ready.'); resetButtons();
        });
    }
    checkStatus();
</script>
]]>
</INLINE>
</FILE>

<!-- 3. API BACKEND -->
<FILE Name="/usr/local/emhttp/plugins/&name;/api.php">
<INLINE>
<![CDATA[
<?php
header('Content-Type: application/json; charset=utf-8');

$action = $_POST['action'] ?? '';
$statusFile = '/tmp/dedupe_status.json';
$logFile = '/tmp/dedupe_scan.log';
$pidFile = '/tmp/dedupe_scan.pid';

function formatBytes($bytes) {
    if ($bytes <= 0) return '0 B';
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    $i = floor(log($bytes, 1024));
    return round($bytes / pow(1024, $i), 2) . ' ' . $units[$i];
}

if ($action === 'logs') {
    echo file_exists($logFile) ? file_get_contents($logFile) : "";
    exit;
}

if ($action === 'scan') {
    $target = $_POST['target'] ?? '';
    $hashMethod = $_POST['hashMethod'] ?? 'sha256sum';
    $deepVerify = $_POST['deepVerify'] ?? '0';
    
    if (file_exists($statusFile)) @unlink($statusFile);
    if (file_exists($logFile)) @unlink($logFile);
    
    $script = '/usr/local/emhttp/plugins/dedupe/scripts/scan.sh';
    $cmd = sprintf("bash -c 'nohup bash %s %s %s %s >> /tmp/dedupe_scan.log 2>&1 & echo $!'", 
        escapeshellarg($script), escapeshellarg($target), escapeshellarg($hashMethod), escapeshellarg($deepVerify));
    exec($cmd, $output);
    file_put_contents($pidFile, trim($output[0] ?? ''));
    echo json_encode(['success' => true]);
    exit;
}

if ($action === 'delete') {
    $files = $_POST['files'] ?? [];
    $count = 0;
    $bytesReclaimed = 0;
    foreach ($files as $file) {
        if (strpos($file, '/mnt/') === 0 && is_file($file)) {
            $bytesReclaimed += filesize($file);
            if (unlink($file)) $count++;
        }
    }
    $spaceStr = formatBytes($bytesReclaimed);
    $msg = "\n[".date('H:i:s')."] Successfully deleted $count files. Reclaimed $spaceStr of space.";
    file_put_contents($logFile, $msg, FILE_APPEND);
    echo json_encode(['success' => true, 'deleted' => $count, 'space' => $spaceStr]);
    exit;
}

if ($action === 'status') {
    echo file_exists($statusFile) ? file_get_contents($statusFile) : json_encode(['status' => 'idle']);
    exit;
}

if ($action === 'clear') {
    @unlink($statusFile);
    @unlink($logFile);
    echo json_encode(['success' => true]);
    exit;
}

if ($action === 'pause') {
    $pid = trim(file_get_contents($pidFile));
    if (preg_match('/^\d+$/', $pid)) { exec("pkill -STOP -P $pid; kill -STOP $pid"); }
    exit;
}

if ($action === 'resume') {
    $pid = trim(file_get_contents($pidFile));
    if (preg_match('/^\d+$/', $pid)) { exec("pkill -CONT -P $pid; kill -CONT $pid"); }
    exit;
}

if ($action === 'cancel') {
    $pid = trim(file_get_contents($pidFile));
    if (preg_match('/^\d+$/', $pid)) { exec("pkill -TERM -P $pid; kill -TERM $pid"); }
    @unlink($statusFile);
    exit;
}
?>
]]>
</INLINE>
</FILE>

<!-- 4. SCAN SCRIPT -->
<FILE Name="/usr/local/emhttp/plugins/&name;/scripts/scan.sh" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
TARGET="$1"
HASH_CMD="$2"
DEEP_VERIFY="$3"
STATUS_FILE="/tmp/dedupe_status.json"
LOG_FILE="/tmp/dedupe_scan.log"
TMP_HASHES=$(mktemp)

update_status() {
    echo "{\"status\":\"running\",\"progress\":$1,\"message\":\"$2\"}" > "$STATUS_FILE"
}

echo "[$(date '+%H:%M:%S')] Scan started on $TARGET" >> "$LOG_FILE"
echo "[$(date '+%H:%M:%S')] Hash Method: $HASH_CMD" >> "$LOG_FILE"

update_status 10 "Step 1: Finding files..."
FILES=$(find "$TARGET" -type f -printf "%s\t%p\n" | sort -n)
TOTAL_FOUND=$(echo "$FILES" | grep -c . || true)
echo "[$(date '+%H:%M:%S')] Indexed $TOTAL_FOUND files." >> "$LOG_FILE"

if [ -z "$FILES" ] || [ "$TOTAL_FOUND" -eq 0 ]; then
    echo "[$(date '+%H:%M:%S')] No files found. Scan complete." >> "$LOG_FILE"
    echo '{"status":"complete","duplicates":[]}' > "$STATUS_FILE"
    exit 0
fi

POTENTIAL=$(echo "$FILES" | awk -F'\t' '{count[$1]++} END{for(i in count)if(count[i]>1)c+=count[i]; print (c+0)}')
echo "[$(date '+%H:%M:%S')] Found $POTENTIAL candidate files with matching sizes." >> "$LOG_FILE"

if [ "$POTENTIAL" -eq 0 ] 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] No identical file sizes found. Scan complete." >> "$LOG_FILE"
    echo '{"status":"complete","duplicates":[]}' > "$STATUS_FILE"
    exit 0
fi

update_status 30 "Step 2: Hashing $POTENTIAL files..."
echo "$FILES" | awk -F'\t' '{a[$1]=a[$1]?a[$1]"\n"$2:$2; count[$1]++} END{for(i in count)if(count[i]>1)print a[i]}' \
    | tr '\n' '\0' \
    | xargs -0 -n 10 "$HASH_CMD" 2>/dev/null \
    | awk -v total="$POTENTIAL" -v sf="$STATUS_FILE" '
{
    print $0; count++
    if (count % 10 == 0 || count == total) {
        p = 30 + int((count * 50) / total)
        printf "{\"status\":\"running\",\"progress\":%d,\"message\":\"Hashing %d/%d...\"}", p, count, total > sf
        close(sf)
    }
}' > "$TMP_HASHES"

update_status 90 "Step 3: Finalizing report..."
/usr/bin/php -r '
    $lines = file($argv[1], FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    $hashes = [];
    foreach($lines as $l) {
        if(preg_match("/^([a-f0-9]+)\s+(.+)$/", $l, $m)) {
            $hashes[$m[1]][] = $m[2];
        }
    }
    $dupes = [];
    foreach($hashes as $h => $f) {
        if(count($f) > 1) {
            $dupes[] = ["hash"=>$h, "files"=>$f, "size"=>(@filesize($f[0]) ?: 0)];
        }
    }
    file_put_contents($argv[2], json_encode(["status"=>"complete", "duplicates"=>$dupes]));
    
    $count = count($dupes);
    @exec("/usr/local/emhttp/webGui/scripts/notify -e \"Dedupe\" -i \"normal\" -s \"Dedupe Scan Finished\" -d \"Found $count duplicate groups.\"");
' "$TMP_HASHES" "$STATUS_FILE"

echo "[$(date '+%H:%M:%S')] Scan complete!" >> "$LOG_FILE"
rm -f "$TMP_HASHES"
]]>
</INLINE>
</FILE>

<!-- 5. UNINSTALLATION HOOK -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
echo "Removing dedupe plugin..."
if [ -f /tmp/dedupe_scan.pid ]; then
    PID=$(cat /tmp/dedupe_scan.pid)
    kill -TERM "$PID" 2>/dev/null || true
fi
rm -rf /usr/local/emhttp/plugins/dedupe
rm -f /tmp/dedupe_status.json /tmp/dedupe_scan.log /tmp/dedupe_scan.pid
echo "Cleanup complete."
]]>
</INLINE>
</FILE>
</PLUGIN>
